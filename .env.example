# Razorpay (test mode — replace with your keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ---------------------------------------------------------------------------
# Vercel Google sign-in (required on tripweave-web.vercel.app)
# Redirect URI in Google Cloud must be EXACTLY:
#   https://tripweave-web.vercel.app/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_URL=https://tripweave-web.vercel.app
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Supabase — see supabase/README.md
# ---------------------------------------------------------------------------
SUPABASE_URL=https://csegihiepvxezuypsvop.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Public keys are also baked into src/lib/supabase/project.ts so the live
# site talks to this project without extra Vercel setup.
# Optional override if you rotate keys:
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=  # optional; writes use the gated RPC without it
# SUPABASE_WRITE_GATE=        # optional; must match public.tw_apply
VITE_SUPABASE_URL=https://csegihiepvxezuypsvop.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Transaction pooler :6543 (not the direct :5432 URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Reviewer consensus (YouTube captions → structured notes)
# XAI_API_KEY is injected by Grok App Builder / Vercel. Do not commit it.
# Without it, package pages still show the curated seed cache.
# Rebuild from videos on a stay page is user-initiated and spends quota.
# ---------------------------------------------------------------------------
# XAI_API_KEY=
# YouTube Data API v3 — fills extra stay-review videos beyond the curated list.
# YOUTUBE_API_KEY=
# Password reset mail (Resend). From must be a verified sender.
# RESEND_API_KEY=
# RESEND_FROM=TripWeave <bookings@yourdomain.com>

# ---------------------------------------------------------------------------
# Money ops (refund cron, reconcile, GST invoice)
# ---------------------------------------------------------------------------
# Vercel cron bearer. Required on production for /api/cron/*.
# CRON_SECRET=
# Ops alerts for captured-but-unbooked payments. Falls back to SES_FROM, then ops@tripweave.app.
# OPS_ALERT_EMAIL=ops@yourdomain.com
# Amazon SES (also used for booking mail + password reset)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM=TripWeave <bookings@yourdomain.com>
# Seller details on GST tax invoices. Leave TW_GSTIN empty until you have a real GSTIN — do not invent one.
# TW_LEGAL_NAME=TripWeave Hospitality Private Limited
# TW_GSTIN=
# TW_SELLER_ADDRESS=Your registered address
# Optional GST rate (%) when the paid total is GST-inclusive (e.g. 12 for hotel). Omit to show total only.
# TW_GST_RATE=12
# Prefer a dedicated webhook secret over reusing the key secret.
# RAZORPAY_WEBHOOK_SECRET=
